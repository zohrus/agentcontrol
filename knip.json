{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "spike/*.ts"],
      "project": ["scripts/**/*.ts", "spike/**/*.ts"]
    },
    "packages/app": { "entry": ["src/drizzle.config.ts"], "project": ["src/**/*.ts"] },
    "packages/ui-template": {
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/*": { "project": ["src/**/*.ts"] },
    "e2e": {
      "entry": ["**/*.e2e.ts", "support/mock-agent/main.ts", "support/setup/flaky-relay.ts"],
      "project": ["**/*.ts"],
      "ignore": ["fixtures/**"]
    }
  }
}
