{
  "name": "agentcontrol",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "biome format --write",
    "format:check": "biome format --error-on-warnings",
    "deps": "depcruise --config .dependency-cruiser.cjs --no-progress packages e2e scripts",
    "knip": "knip --max-issues 0",
    "dup": "jscpd",
    "audit": "bun audit",
    "test": "bun run scripts/run-e2e.ts",
    "prove-gates": "bun run scripts/prove-gates.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run deps && bun run knip && bun run dup && bun run audit && bun run test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@types/bun": "1.4.5",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jscpd": "5.4.2",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.9"
  }
}
