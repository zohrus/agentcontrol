{
  "name": "agentcontrol",
  "private": true,
  "type": "module",
  "license": "MIT",
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/main.tsbuildinfo && tsc -p packages/ui-template/tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/ui-template.tsbuildinfo",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings 0 .",
    "format": "bun scripts/format.ts",
    "format:check": "biome format --error-on-warnings",
    "deps": "depcruise --config .dependency-cruiser.cjs --no-progress --cache --cache-strategy content packages e2e scripts",
    "knip": "knip --max-issues 0 --cache --cache-location node_modules/.cache/knip",
    "dup": "jscpd",
    "acp-leaks": "bun scripts/acp-leaks.ts",
    "audit": "bun audit",
    "test": "bun run scripts/run-e2e.ts",
    "test:coverage": "bun run scripts/coverage.ts",
    "test:coverage-stable": "bun run scripts/coverage-stable.ts",
    "prove-gates": "bun run scripts/prove-gates.ts",
    "check": "bun scripts/check.ts",
    "relay": "bun packages/relay/src/main.ts daemon",
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "build:relay-linux-x64": "bun scripts/build.ts --only relay-linux-x64",
    "build:mac": "bun scripts/build.ts --only darwin",
    "build:linux": "bun scripts/build.ts --linux-app --only linux",
    "check:quick": "bun scripts/check-quick.ts",
    "integrate": "bun scripts/integrate.ts",
    "done": "bun scripts/done.ts",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@types/bun": "1.4.5",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jscpd": "5.4.3",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "esbuild": "0.25.12",
    "minimatch": "11.0.9"
  }
}
